res(historia_inicial)\n","pares_cambios = contar_pares(cambios_observados)\n","\n","nombres_cortos = [\n","    \"28d\", \"91d\", \"182d\", \"364d\",\n","    \"3a\", \"5a\", \"10a\", \"20a\", \"30a\"\n","]\n","\n","fig, axes = plt.subplots(\n","    1, 2,\n","    figsize=(16, 6),\n","    constrained_layout=True\n",")\n","\n","for ax, matriz, titulo in zip(\n","    axes,\n","    [correlacion_niveles, correlacion_cambios],\n","    [\"Tasas en niveles\", \"Cambios mensuales observados\"]\n","):\n","    imagen = ax.imshow(\n","        matriz.to_numpy(),\n","        cmap=\"RdBu_r\",\n","        vmin=-1,\n","        vmax=1\n","    )\n","\n","    ax.set_xticks(range(9))\n","    ax.set_yticks(range(9))\n","    ax.set_xticklabels(nombres_cortos)\n","    ax.set_yticklabels(nombres_cortos)\n","    ax.set_title(titulo, fontweight=\"bold\")\n","    ax.grid(False)\n","\n","    for i in range(9):\n","        for j in range(9):\n","            valor = matriz.iloc[i, j]\n","\n","            ax.text(\n","                j, i,\n","                f\"{valor:.2f}\" if pd.notna(valor) else \"—\",\n","                ha=\"center\",\n","                va=\"center\",\n","                fontsize=8,\n","                color=(\n","                    \"white\"\n","                    if pd.notna(valor) and abs(valor) > 0.6\n","                    else \"black\"\n","                )\n","            )\n","\n","fig.colorbar(\n","    imagen,\n","    ax=axes,\n","    shrink=0.8,\n","    label=\"Correlación de Pearson\"\n",")\n","\n","plt.show()\n","\n","print(\"Número de parejas válidas: niveles\")\n","display(pares_niveles.rename(index=etiquetas, columns=etiquetas))\n","\n","print(\"Número de parejas válidas: cambios mensuales\")\n","display(pares_cambios.rename(index=etiquetas, columns=etiquetas))"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":1000},"id":"4sM3Ia5Ob6Jo","executionInfo":{"status":"ok","timestamp":1791813992467,"user_tz":300,"elapsed":850,"user":{"displayName