urva.columns:\n","\n","                # Entrenar solo con objetivos reales de este instrumento\n","                disponibles = Y_train[instrumento].notna()\n","\n","                modelo = make_pipeline(\n","                    StandardScaler(),\n","                    Ridge(alpha=alpha, solver=\"svd\")\n","                )\n","\n","                modelo.fit(\n","                    X_train.loc[disponibles],\n","                    Y_train.loc[disponibles, instrumento]\n","                )\n","\n","                pronostico = float(modelo.predict(X_origen)[0])\n","\n","                if not np.isfinite(pronostico):\n","                    raise ValueError(\n","                        f\"Pronóstico inválido: {instrumento}, {origen}\"\n","                    )\n","\n","                registros_ridge.append({\n","                    \"Modelo\": nombre_modelo,\n","                    \"Etapa\": \"Validación\",\n","                    \"Origen\": origen,\n","                    \"Horizonte\": h,\n","                    \"Objetivo\": objetivo,\n","                    \"Instrumento\": instrumento,\n","                    \"Real\": curva.loc[objetivo, instrumento],\n","                    \"Pronostico\": pronostico,\n","                    \"Alpha\": alpha,\n","                    \"N_entrenamiento\": int(disponibles.sum())\n","                })\n","\n","        if numero % 12 == 0:\n","            print(\n","                f\"alpha={alpha:g}: \"\n","                f\"{numero}/{len(origenes_validacion)} orígenes\"\n","            )\n","\n","predicciones_ridge_validacion = pd.DataFrame(registros_ridge)\n","\n","# Verificar que la comparación utiliza los mismos objetivos del baseline\n","claves = [\"Etapa\", \"Origen\", \"Horizonte\", \"Objetivo\", \"Instrumento\"]\n","\n","referencia = predicciones_baseline_validacion.set_index(\n","    claves\n",")[\"Real\"].sort_index()\n","\n","for nombre, grupo in predicciones_ridge_validacion.groupby(\"Modelo\"):\n","    co