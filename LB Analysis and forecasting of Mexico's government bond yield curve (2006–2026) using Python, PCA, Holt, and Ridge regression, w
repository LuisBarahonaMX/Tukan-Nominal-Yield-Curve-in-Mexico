       \"description\": \"\"\n      }\n    }\n  ]\n}"}},"metadata":{}}]},{"cell_type":"markdown","source":["### Celda 7. Preparar los datos sin utilizar información futura\n","Arrastraremos la última tasa observada para construir las entradas. También registraremos su antigüedad: una tasa arrastrada no es una nueva observación."],"metadata":{"id":"d3wgaOrWbq8O"}},{"cell_type":"code","source":["# CELDA 7 — Preparación causal de faltantes\n","\n","def preparar_historia(curva_original, fecha_corte):\n","    historia = curva_original.loc[:fecha_corte].copy()\n","\n","    # Solo utiliza observaciones anteriores\n","    preparada = historia.ffill()\n","\n","    # Antigüedad del último dato real, en meses\n","    posiciones = pd.Series(\n","        np.arange(len(historia)),\n","        index=historia.index,\n","        dtype=float\n","    )\n","\n","    antiguedad = pd.DataFrame(\n","        index=historia.index,\n","        columns=historia.columns,\n","        dtype=float\n","    )\n","\n","    for instrumento in historia.columns:\n","        ultima_posicion = posiciones.where(\n","            historia[instrumento].notna()\n","        ).ffill()\n","\n","        antiguedad[instrumento] = posiciones - ultima_posicion\n","\n","    # Excluir meses iniciales donde algún plazo aún no tiene historia\n","    filas_utilizables = preparada.notna().all(axis=1)\n","\n","    return (\n","        preparada.loc[filas_utilizables],\n","        antiguedad.loc[filas_utilizables]\n","    )\n","\n","historia_inicial = curva.loc[:FIN_ENTRENAMIENTO_INICIAL].copy()\n","\n","curva_inicial_preparada, antiguedad_inicial = preparar_historia(\n","    curva,\n","    FIN_ENTRENAMIENTO_INICIAL\n",")\n","\n","mascara_imputados_inicial = historia_inicial.loc[\n","    curva_inicial_preparada.index\n","].isna()\n","\n","resumen_preparacion = pd.DataFrame({\n","    \"Valores arrastrados\": mascara_imputados_inicial.sum(),\n","    \"Mayor antigüedad (meses)\": antiguedad_inicial.max(),\n","    \"Entradas con antigüedad > 3 meses\": (\n","        antiguedad_inicial > 3\n","    ).sum()\n","})\n","\n","print(\n","    f\"Periodo preparado: {curva_inicial_preparada.index.min():%Y-%m}\"\n","    f\" a {curva_inicial_preparada.index.max():%Y-%m}\"\n",")\n","print(f\"Meses utilizables: {len(curva_inicial_preparada)}\")\n","print(\n","    \"Meses iniciales excluidos por falta de historia:\",\n","    len(historia_inicial) - len(curva_inicial_preparada)\n",")\n","\n","display(resumen_preparacion)\n","display(curva_inicial_preparada.head())\n","\n","# Comprobar que ninguna observación real fue alterada\n","original_alineada = historia_inicial.loc[\n","    curva_inicial_preparada.index\n","]\n","\n","reales = original_alineada.notna()\n","\n","assert (\n","    curva_inicial_preparada.where(reales)\n","    .equals(original_alineada)\n",")\n","\n","print(\"Verificación: las tasas realmente observadas se conservaron.\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":653},"id":"nUIGTFDObttW","executionInfo":{"status":"ok","timestamp":1791813936539,"user_tz":300,"elapsed":104,"user":{"displayName":"PEDRO LUIS PEREZ BARAHONA","userId":"16526492446743362157"}},"outputId":"0e09e6c3-74c3-4bb9-afbe-1978f5adf686"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Periodo preparado: 2006-11 a 2016-09\n","Meses utilizables: 119\n","Meses iniciales excluidos por falta de historia: 1\n"]},{"output_type":"display_data","data":{"text/plain":["                  Valores arrastrados  Mayor antigüedad (meses)  \\\n","INSTRUMENT                                                        \n","CETEs, 28 days                      0                       0.0   \n","CETEs, 91 days                      0                       0.0   \n","CETEs, 182 days                     0                       0.0   \n","CETEs, 364 days                     0                       0.0   \n","MBONOs, 3 years                     0                       0.0   \n","MBONOs, 5 yea