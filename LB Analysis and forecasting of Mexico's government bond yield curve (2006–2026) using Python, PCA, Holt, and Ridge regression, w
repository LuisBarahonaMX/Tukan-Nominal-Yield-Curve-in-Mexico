p, X_origen_p, _ = construir_diseno_pca(\n","            curva, origen, h,\n","            n_componentes=config_pca[\"n_componentes\"],\n","            n_meses=CONFIGURACIONES_FINALES[\"Meses_de_entrada\"]\n","        )\n","\n","        assert X_r.index.equals(X_p.index)\n","        assert Y_r.equals(Y_p)\n","\n","        pred_pca = ajustar_ridge_por_plazo(\n","            X_p, Y_p, X_origen_p,\n","            alpha=config_pca[\"alpha\"]\n","        )\n","\n","        phi = CONFIGURACIONES_FINALES[\"Holt\"][h]\n","\n","        for instrumento in curva.columns:\n","            predicciones = {\n","                \"Persistencia\": preparada.iloc[-1][instrumento],\n","                \"Holt\": pronosticos_holt[(instrumento, phi)][h - 1],\n","                \"Ridge\": pred_ridge[instrumento],\n","                \"PCA + Ridge\": pred_pca[instrumento]\n","            }\n","\n","            for nombre, prediccion in predicciones.items():\n","                registros_prueba.append({\n","                    \"Modelo\": nombre,\n","                    \"Etapa\": \"Prueba\",\n","                    \"Origen\": origen,\n","                    \"Horizonte\": h,\n","                    \"Objetivo\": objetivo,\n","                    \"Instrumento\": instrumento,\n","                    \"Real\": curva.loc[objetivo, instrumento],\n","                    \"Pronostico\": float(prediccion)\n","                })\n","\n","    if numero % 12 == 0:\n","        print(f\"Prueba: {numero}/{len(origenes_prueba)} orígenes\")\n","\n","\n","predicciones_prueba = pd.DataFrame(registros_prueba)\n","diagnosticos_holt_prueba = pd.DataFrame(\n","    diagnosticos_holt_prueba_lista\n",")\n","\n","# Verificar comparación sobre los mismos objetivos\n","claves = [\"Etapa\", \"Origen\", \"Horizonte\", \"Objetivo\", \"Instrumento\"]\n","\n","referencia_prueba = (\n","    predicciones_prueba.loc[\n","        predicciones_prueba[\"Modelo\"].eq(\"Persistencia\")\n","    ]\n","    .set_index(claves)[\"Real\"]\n","    .sort_index()\n",")\n","\n","for nombre, grupo in predicciones_prueba.groupby(\"Modelo\"):\n","    assert not grupo.duplicated(claves).any()\n","\n","    reales = grupo.set_index(claves)[\"Real\"].sort_index()\n","\n","    assert reales.index.equals(referencia_prueba.index), nombre\n","    assert np.allclose(\n","        reales.to_numpy(),\n","        referencia_prueba.to_numpy(),\n","        equal_nan=True\n","    ), nombre\n","\n","metricas_prueba_plazo, metricas_prueba_global = calcular_metricas(\n","    predicciones_prueba\n",")\n","\n","# Cobertura esperada del calendario establecido\n","assert metricas_prueba_global[\"Plazos_evaluados\"].eq(9).all()\n","\n","for h, cantidad in {3: 491, 12: 492}.items():\n","    assert metricas_prueba_global.loc[\n","        metricas_prueba_global[\"Horizonte\"].eq(h),\n","        \"Observaciones\"\n","    ].eq(cantidad).all()\n","\n","print(\"\\nRESULTADOS DE PRUEBA FINAL\")\n","print(\n","    metricas_prueba_global\n","    .sort_values([\"Horizonte\", \"RMSE_pb\"])\n","    .round(2)\n","    .to_string(index=False)\n",")\n","\n","print(\"\\nDIAGNÓSTICOS DE HOLT\")\n","print(f\"Ajustes: {len(diagnosticos_holt_prueba)}\")\n","print(f\"Convergentes: {diagnosticos_holt_prueba['Convergio'].sum()}\")\n","print(\n","    \"Ajustes con avisos:\",\n","    diagnosticos_holt_prueba[\"Avisos\"].ne(\"\").sum()\n",")\n","\n","print(\"\\nVerificado: mismos objetivos y configuraciones fijadas.\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"h60h_D6ixxXc","executionInfo":{"status":"ok","timestamp":1791819773840,"user_tz":300,"elapsed":48938,"user":{"displayName":"PEDRO LUIS PEREZ BARAHONA","userId":"16526492446743362157"}},"outputId":"c4a6a3ef-45fc-467f-eb5b-11e784e52885"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Prueba: 12/60 orígenes\n","Prueba: 24/60 orígenes\n","Prueba: 36/60 orígenes\n","Prueba: 48/60 orígenes\n","Prueba: 60/60 orígenes\n","\n","RESULTADOS DE PRUE