rizonte,\n","    n_componentes=3,\n","    n_meses=3\n","):\n","    origen = pd.Timestamp(origen)\n","\n","    preparada, _ = preparar_historia(curva_original, origen)\n","\n","    # PCA centrado, sin estandarizar las nueve tasas.\n","    # Se ajusta de nuevo con la historia disponible en cada origen.\n","    pca = PCA(\n","        n_components=n_componentes,\n","        svd_solver=\"full\"\n","    )\n","\n","    factores = pd.DataFrame(\n","        pca.fit_transform(preparada),\n","        index=preparada.index,\n","        columns=[\n","            f\"PC{i + 1}\" for i in range(n_componentes)\n","        ]\n","    )\n","\n","    # Factores del mes s y de los dos meses anteriores\n","    X = pd.concat([\n","        factores.shift(rezago).add_suffix(\n","            f\" | rezago={rezago}\"\n","        )\n","        for rezago in range(n_meses)\n","    ], axis=1)\n","\n","    # Los objetivos siguen siendo las tasas originales\n","    Y = (\n","        curva_original.loc[:origen, preparada.columns]\n","        .shift(-horizonte)\n","        .reindex(X.index)\n","    )\n","\n","    fechas_objetivo = pd.Series(\n","        X.index + pd.DateOffset(months=horizonte),\n","        index=X.index\n","    )\n","\n","    elegibles = (\n","        X.notna().all(axis=1)\n","        & fechas_objetivo.le(origen)\n","        & Y.notna().any(axis=1)\n","    )\n","\n","    X_train = X.loc[elegibles].copy()\n","    Y_train = Y.loc[elegibles].copy()\n","    X_origen = X.loc[[origen]].copy()\n","\n","    assert np.isfinite(X_train.to_numpy()).all()\n","    assert np.isfinite(X_origen.to_numpy()).all()\n","    assert fechas_objetivo.loc[elegibles].le(origen).all()\n","\n","    return X_train, Y_train, X_origen, pca\n","\n","\n","# Verificación en el primer origen de validación\n","origen_revision = origenes_validacion[0]\n","resumen_diseno_pca = []\n","\n","for k in [1, 2, 3]:\n","    for h in HORIZONTES:\n","\n","        X_pca, Y_pca, X_origen_pca, pca = construir_diseno_pca(\n","            curva,\n","            origen=origen_revision,\n","            horizonte=h,\n","            n_componentes=k\n","        )\n","\n","        X_ridge, Y_ridge, _, _ = construir_diseno_ridge(\n","            curva,\n","            origen=origen_revision,\n","            horizonte=h\n","        )\n","\n","        # Mismas filas y objetivos que Ridge sin PCA\n","        assert X_pca.index.equals(X_ridge.index)\n","        assert Y_pca.equals(Y_ridge)\n","\n","        # Comprobar que no influye información posterior al origen\n","        curva_alterada = curva.copy()\n","        curva_alterada.loc[\n","            curva_alterada.index > origen_revision\n","        ] = 999.0\n","\n","        X_control, Y_control, X_origen_control, _ = (\n","            construir_diseno_pca(\n","                curva_alterada,\n","                origen=origen_revision,\n","                horizonte=h,\n","                n_componentes=k\n","            )\n","        )\n","\n","        assert X_pca.equals(X_control)\n","        assert Y_pca.equals(Y_control)\n","        assert X_origen_pca.equals(X_origen_control)\n","\n","        resumen_diseno_pca.append({\n","            \"Horizonte\": h,\n","            \"Componentes\": k,\n","            \"Filas\": len(X_pca),\n","            \"Predictores\": X_pca.shape[1],\n","            \"Varianza retenida (%)\": (\n","                pca.explained_variance_ratio_.sum() * 100\n","            )\n","        })\n","\n","print(f\"Origen de revisión: {origen_revision:%Y-%m}\")\n","print(\n","    pd.DataFrame(resumen_diseno_pca)\n","    .round(2)\n","    .to_string(index=False)\n",")\n","\n","print(\"\\nVerificaciones correctas:\")\n","print(\"- Mismas filas y objetivos originales que Ridge.\")\n","print(\"- Los datos futuros no influyen.\")\n","print(\"- Ridge sobre factores todavía no se ha entrenado.\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"NUdJn4fEt7IM","executionInfo":{"status":"ok","timestamp":1791818711808,"user_tz"