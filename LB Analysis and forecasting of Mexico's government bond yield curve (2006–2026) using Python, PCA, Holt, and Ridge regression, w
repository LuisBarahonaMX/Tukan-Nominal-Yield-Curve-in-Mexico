a_MAE_%\", \"Mejora_RMSE_%\"\n","    ]]\n","    .sort_values([\"Horizonte\", \"RMSE_pb\"])\n","    .round(2)\n","    .to_string(index=False)\n",")\n","\n","# Comparación por instrumento sobre objetivos idénticos\n","baseline_plazo_prueba = (\n","    metricas_prueba_plazo.loc[\n","        metricas_prueba_plazo[\"Modelo\"].eq(\"Persistencia\"),\n","        [\"Etapa\", \"Horizonte\", \"Instrumento\", \"N\", \"RMSE_pb\"]\n","    ]\n","    .rename(columns={\n","        \"N\": \"N_baseline\",\n","        \"RMSE_pb\": \"RMSE_baseline\"\n","    })\n",")\n","\n","comparacion_prueba_plazo = (\n","    metricas_prueba_plazo.loc[\n","        metricas_prueba_plazo[\"Modelo\"].ne(\"Persistencia\")\n","    ]\n","    .merge(\n","        baseline_plazo_prueba,\n","        on=[\"Etapa\", \"Horizonte\", \"Instrumento\"],\n","        validate=\"many_to_one\"\n","    )\n",")\n","\n","assert comparacion_prueba_plazo[\"N\"].equals(\n","    comparacion_prueba_plazo[\"N_baseline\"]\n",")\n","\n","comparacion_prueba_plazo[\"Mejora_RMSE_%\"] = (\n","    1\n","    - comparacion_prueba_plazo[\"RMSE_pb\"]\n","    / comparacion_prueba_plazo[\"RMSE_baseline\"]\n",") * 100\n","\n","tabla_mejoras_plazo = comparacion_prueba_plazo.pivot(\n","    index=[\"Horizonte\", \"Instrumento\"],\n","    columns=\"Modelo\",\n","    values=\"Mejora_RMSE_%\"\n",").reset_index()\n","\n","tabla_mejoras_plazo[\"Orden\"] = (\n","    tabla_mejoras_plazo[\"Instrumento\"].map(orden_plazos)\n",")\n","\n","tabla_mejoras_plazo = tabla_mejoras_plazo.sort_values(\n","    [\"Horizonte\", \"Orden\"]\n",").drop(columns=\"Orden\")\n","\n","tabla_mejoras_plazo[\"Instrumento\"] = (\n","    tabla_mejoras_plazo[\"Instrumento\"].map(etiquetas)\n",")\n","\n","print(\"\\nMEJORA DEL RMSE POR PLAZO (%)\")\n","print(tabla_mejoras_plazo.round(2).to_string(index=False))\n","\n","print(\"\\nPLAZOS CON MENOR RMSE QUE PERSISTENCIA\")\n","for (h, modelo), grupo in comparacion_prueba_plazo.groupby(\n","    [\"Horizonte\", \"Modelo\"]\n","):\n","    cantidad = int(grupo[\"Mejora_RMSE_%\"].gt(0).sum())\n","    print(f\"{h} meses — {modelo}: {cantidad} de {len(grupo)}\")\n","\n","# Comparación específica: PCA + Ridge frente a Ridge\n","tabla_aporte_pca = (\n","    metricas_prueba_global.loc[\n","        metricas_prueba_global[\"Modelo\"].isin([\"Ridge\", \"PCA + Ridge\"])\n","    ]\n","    .pivot(index=\"Horizonte\", columns=\"Modelo\", values=\"RMSE_pb\")\n",")\n","\n","tabla_aporte_pca[\"Mejora_PCA_sobre_Ridge_%\"] = (\n","    1 - tabla_aporte_pca[\"PCA + Ridge\"] / tabla_aporte_pca[\"Ridge\"]\n",") * 100\n","\n","print(\"\\nAPORTE DEL PCA FRENTE A RIDGE\")\n","print(tabla_aporte_pca.round(2).to_string())\n","\n","print(\"\\nPorcentaje positivo = menor RMSE; negativo = mayor RMSE.\")\n","print(\"Las diferencias aún no cuentan con intervalos de incertidumbre.\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"QdEeed9S11C9","executionInfo":{"status":"ok","timestamp":1791820781990,"user_tz":300,"elapsed":207,"user":{"displayName":"PEDRO LUIS PEREZ BARAHONA","userId":"16526492446743362157"}},"outputId":"e003ffa1-467b-45b6-a8c4-95ac11bd1cdd"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["MEJORAS GLOBALES FRENTE A PERSISTENCIA\n"," Horizonte       Modelo  MAE_pb  RMSE_pb  Mejora_MAE_%  Mejora_RMSE_%\n","         3         Holt   45.92    56.84         19.35          18.22\n","         3        Ridge   44.72    57.58         21.45          17.15\n","         3  PCA + Ridge   46.33    58.98         18.62          15.14\n","         3 Persistencia   56.93    69.50          0.00           0.00\n","        12         Holt  136.48   173.22         13.99          15.37\n","        12        Ridge  170.07   195.44         -7.18           4.51\n","        12  PCA + Ridge  169.58   202.22         -6.87           1.20\n","        12 Persistencia  158.68   204.67          0.00           0.00\n","\n","MEJORA DEL RMSE POR PLAZO (%)\n"," Horizonte     Instrumento  Holt  PCA + Ridge  Ridge\n","         3   CETES 28 días 41.36        60.32  61.60\n","         3   CETES 91 días 48.29        46.84  56.93\n","         3  CETES 182 días 40.83        27.11  43.73\n","         3  CETES 364 días 27.49         6.00  23.53\n","         3  BONOS M 3 años  1.32         3.76   6.01\n","         3  BONOS M 5 años -0.28        -0.49  -4.97\n","         3 BONOS M 10 años -0.05        -2.43  -7.19\n","         3 BONOS M 20 años  0.19         0.65  -8.85\n","         3 BONOS M 30 años  3.05        -0.96 -14.15\n","        12   CETES 28 días 20.90        21.61  31.13\n","        12   CETES 91 días 23.66        15.13  24.13\n","        12  CETES 182 días 21.82         7.79  15.81\n","        12  CETES 364 días 16.78        -2.36   3.82\n","        12  BONOS M 3 años  1.47       -18.83 -21.87\n","        12  BONOS M 5 años -0.63       -23.17 -30.01\n","        12 BONOS M 10 años -0.62       -24.88 -31.62\n","        12 BONOS M 20 años  0.03       -29.85 -43.07\n","        12 BONOS M 30 años -0.69       -27.64 -38.17\n","\n","PLAZOS CON MENOR RMSE QUE PERSISTENCIA\n","3 meses — Holt: 7 de 9\n","3 meses — PCA + Ridge: 6 de 9\n","3 meses — Ridge: 5 de 9\n","12 meses — Holt: 6 de 9\n","12 meses — PCA + Ridge: 3 de 9\n","12 meses — Ridge: 4 de 9\n","\n","APORTE DEL PCA FRENTE A RIDGE\n","Modelo     PCA + Ridge   Ridge  Mejora_PCA_sobre_Ridge_%\n","Horizonte                                               \n","3                58.98   57.58                     -2.43\n","12              202.22  195.44                     -3.47\n","\n","Porcentaje positivo = menor RMSE; negativo = mayor RMSE.\n","Las diferencias aún no cuentan con intervalos de incertidumbre.\n"]}]},{"cell_type":"code","source":["# CELDA 25 — Bootstrap pareado por bloques temporales\n","\n","N_BOOTSTRAP = 2000\n","SEMILLA_BOOTSTRAP = 2026\n","\n","comparaciones_bootstrap = [\n","    (\"Holt\", \"Persistencia\"),\n","    (\"Ridge\", \"Persistencia\"),\n","    (\"PCA + Ridge\", \"Persistencia\"),\n","    (\"PCA + Ridge\", \"Ridge\")\n","]\n","\n","def rmse_global_desde_errores(errores):\n","    # Entrada: meses × plazos, o réplicas × meses × plazos\n","    # Igual peso por instrumento, como en las métricas anteriores\n","    mse_por_plazo = np.nanmean(\n","        np.square(errores), axis=-2\n","    )\n","    return np.sqrt(mse_por_plazo.mean(axis=-1))\n","\n","\n","resultados_bootstrap = []\n","\n","for h in HORIZONTES:\n","    datos_h = predicciones_prueba.loc[\n","        predicciones_prueba[\"Horizonte\"].eq(h)\n","    ].copy()\n","\n","    datos_h[\"Error_pb\"] = (\n","        datos_h[\"Pronostico\"] - datos_h[\"Real\"]\n","    ) * 100\n","\n","    errores_modelos = {}\n","\n","    for nombre, grupo in datos_h.groupby(\"Modelo\"):\n","        tabla = (\n","            grupo.pivot(\n","                index=\"Origen\",\n","                columns=\"Instrumento\",\n","                values=\"Error_pb\"\n","            )\n","            .reindex(\n","                index=origenes_prueba,\n","                columns=orden_instrumentos\n","            )\n","        )\n","\n","        errores_modelos[nombre] = tabla.to_numpy()\n","\n","    # Confirmar la misma máscara de objetivos observados\n","    mascara_referencia = np.isfinite(\n","        errores_modelos[\"Persistencia\"]\n","    )\n","\n","    for nombre, errores in errores_modelos.items():\n","        assert np.array_equal(\n","            np.isfinite(errores), mascara_referencia\n","        ), nombre\n","\n","    n = len(origenes_prueba)\n","\n","    for longitud_bloque in [h, 2 * h]:\n","        rng = np.random.default_rng(\n","            SEMILLA_BOOTSTRAP + h + longitud_bloque\n","        )\n","\n","        numero_bloques = int(np.ceil(n / longitud_bloque))\n","\n","        # Bootstrap circular: los bloques pueden envolver el final\n","        inicios = rng.integers(\n","            0, n,\n","            size=(N_BOOTSTRAP, numero_bloques)\n","        )\n","\n","        indices = (\n","            (\n","                inicios[..., None]\n","                + np.arange(longitud_bloque)\n","            ) % n\n","        ).reshape(N_BOOTSTRAP, -1)[:, :n]\n","\n","        for modelo, referencia in comparaciones_bootstrap:\n","            errores_a = errores_modelos[modelo]\n","            errores_b = errores_modelos[referencia]\n","\n","            # Las mismas fechas se remuestrean en ambos modelos\n","            muestra_a = errores_a[indices]\n","            muestra_b = errores_b[indices]\n","\n","            # Cada réplica debe conservar datos de todos los plazos\n","            replicas_validas = (\n","                np.isfinite(muestra_a).any(axis=1).all(axis=1)\n","                & np.isfinite(muestra_b).any(axis=1).all(axis=1)\n","            )\n","\n","            if replicas_validas.sum() < 0.95 * N_BOOTSTRAP:\n","                raise ValueError(\n","                    \"Demasiadas réplicas sin cobertura de los nueve plazos.\"\n","                )\n","\n","            diferencias = (\n","                rmse_global_desde_errores(muestra_a[replicas_validas])\n","                - rmse_global_desde_errores(muestra_b[replicas_validas])\n","            )\n","\n","            diferencia_observada = (\n","                rmse_global_desde_errores(errores_a)\n","                - rmse_global_desde_errores(errores_b)\n","            )\n","\n","            inferior, superior = np.quantile(\n","                diferencias, [0.025, 0.975]\n","            )\n","\n","            if superior < 0:\n","                lectura = \"Intervalo a favor del modelo\"\n","            elif inferior > 0:\n","                lectura = \"Intervalo a favor de la referencia\"\n","            else:\n","                lectura = \"Incluye cero\"\n","\n","            resultados_bootstrap.append({\n","                \"Horizonte\": h,\n","                \"Bloque_meses\": longitud_bloque,\n","                \"Modelo\": modelo,\n","                \"Referencia\": referencia,\n","                \"Diferencia_RMSE_pb\": diferencia_observada,\n","                \"IC95_inferior\": inferior,\n","                \"IC95_superior\": superior,\n","                \"Replicas_validas\": int(replicas_validas.sum()),\n","                \"Lectura\": lectura\n","            })\n","\n","intervalos_comparacion = pd.DataFrame(resultados_bootstrap)\n","\n","print(\"DIFERENCIA = RMSE DEL MODELO − RMSE DE LA REFERENCIA\")\n","print(\"Valores negativos favorecen al modelo.\\n\")\n","\n","print(\n","    intervalos_comparacion\n","    .round(2)\n","    .to_string(index=False)\n",")\n","\n","print(\n","    \"\\nIntervalos exploratorios del desempeño comparado; \"\n","    \"no son intervalos de predicción de tasas futuras.\"\n",")\n","print(\n","    \"Se remuestrean errores de modelos ya seleccionados, sin reentrenarlos. \"\n","    \"No se ajusta por comparaciones múltiples.\"\n",")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"uStXMTnn2W8J","executionInfo":{"status":"ok","timestamp":1791820923115,"user_tz":300,"elapsed":1686,"user":{"displayName":"PEDRO LUIS PEREZ BARAHONA","userId":"16526492446743362157"}},"outputId":"bac43dd8-f819-48d2-c86a-1ec837b65284"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["DIFERENCIA = RMSE DEL MODELO − RMSE DE LA REFERENCIA\n","Valores negativos favorecen al modelo.\n","\n"," Horizonte  Bloque_meses      Modelo   Referencia  Diferencia_RMSE_pb  IC95_inferior  IC95_superior  Replicas_validas                      Lectura\n","         3             3        Holt Persistencia              -12.66         -19.81          -5.47              2000 Intervalo a favor del modelo\n","         3             3       Ridge Persistencia              -11.92         -23.85           0.08              2000                 Incluye cero\n","         3             3 PCA + Ridge Persistencia              -10.52         -18.55          -2.36              2000 Intervalo a favor del modelo\n","         3   