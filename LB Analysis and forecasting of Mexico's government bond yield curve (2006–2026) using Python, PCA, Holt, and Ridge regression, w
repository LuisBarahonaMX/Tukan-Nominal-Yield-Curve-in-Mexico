","    assert np.isfinite(X_train.to_numpy()).all()\n","    assert np.isfinite(X_origen.to_numpy()).all()\n","    assert fechas_objetivo.loc[elegibles].le(origen).all()\n","    assert Y_train.notna().sum().gt(0).all()\n","\n","    return (\n","        X_train,\n","        Y_train,\n","        X_origen,\n","        fechas_objetivo.loc[elegibles]\n","    )\n","\n","\n","# Comprobar el primer origen de validación\n","origen_revision = origenes_validacion[0]\n","\n","for h in HORIZONTES:\n","    X_train, Y_train, X_origen, fechas_objetivo = (\n","        construir_diseno_ridge(\n","            curva,\n","            origen=origen_revision,\n","            horizonte=h,\n","            n_meses=3\n","        )\n","    )\n","\n","    print(f\"\\nHORIZONTE: {h} MESES\")\n","    print(f\"Origen: {origen_revision:%Y-%m}\")\n","    print(f\"Filas de entrenamiento: {len(X_train)}\")\n","    print(f\"Predictores: {X_train.shape[1]}\")\n","    print(f\"Último objetivo disponible: {fechas_objetivo.max():%Y-%m}\")\n","\n","    print(\"\\nObjetivos observados por instrumento:\")\n","    print(Y_train.count().rename(index=etiquetas).to_string())\n","\n","    # Verificar que los datos futuros no influyen\n","    curva_futuro_alterado = curva.copy()\n","    curva_futuro_alterado.loc[\n","        curva_futuro_alterado.index > origen_revision\n","    ] = 999.0\n","\n","    X_control, Y_control, X_origen_control, _ = (\n","        construir_diseno_ridge(\n","            curva_futuro_alterado,\n","            origen=origen_revision,\n","            horizonte=h,\n","            n_meses=3\n","        )\n","    )\n","\n","    assert X_train.equals(X_control)\n","    assert Y_train.equals(Y_control)\n","    assert X_origen.equals(X_origen_control)\n","\n","print(\"\\nComprobación correcta: los datos futuros no influyen.\")\n","print(\"Todavía no se ha entrenado Ridge.\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"-qbIxPGep1p7","executionInfo":{"status":"ok","timestamp":1