n[\"Phi\"].eq(phi)\n","        ]\n","    )\n","\n","predicciones_holt_seleccionado = pd.concat(\n","    seleccionadas,\n","    ignore_index=True\n",")\n","\n","_, metricas_holt_seleccionado = calcular_metricas(\n","    predicciones_holt_seleccionado\n",")\n","\n","comparacion_holt_baseline = metricas_holt_seleccionado.merge(\n","    metricas_baseline_global[\n","        [\"Etapa\", \"Horizonte\", \"MAE_pb\", \"RMSE_pb\"]\n","    ],\n","    on=[\"Etapa\", \"Horizonte\"],\n","    suffixes=(\"_Holt\", \"_Baseline\"),\n","    validate=\"one_to_one\"\n",")\n","\n","comparacion_holt_baseline[\"Mejora_RMSE_%\"] = (\n","    1\n","    - comparacion_holt_baseline[\"RMSE_pb_Holt\"]\n","    / comparacion_holt_baseline[\"RMSE_pb_Baseline\"]\n",") * 100\n","\n","display(\n","    comparacion_holt_baseline[[\n","        \"Horizonte\", \"Modelo\",\n","        \"MAE_pb_Holt\", \"MAE_pb_Baseline\",\n","        \"RMSE_pb_Holt\", \"RMSE_pb_Baseline\",\n","        \"Mejora_RMSE_%\"\n","    ]].round(2)\n",")\n","\n","plazos_visualizar = [\n","    \"CETEs, 28 days\",\n","    \"MBONOs, 10 years\"\n","]\n","\n","fig, axes = plt.subplots(\n","    2, 2,\n","    figsize=(15, 9),\n","    constrained_layout=True\n",")\n","\n","for fila, instrumento in enumerate(plazos_visualizar):\n","    for columna, h in enumerate(HORIZONTES):\n","        ax = axes[fila, columna]\n","\n","        holt = predicciones_holt_seleccionado.loc[\n","            predicciones_holt_seleccionado[\"Instrumento\"].eq(instrumento)\n","            & predicciones_holt_seleccionado[\"Horizonte\"].eq(h)\n","        ].sort_values(\"Objetivo\")\n","\n","        baseline = predicciones_baseline_validacion.loc[\n","            predicciones_baseline_validacion[\"Instrumento\"].eq(instrumento)\n","            & predicciones_baseline_validacion[\"Horizonte\"].eq(h)\n","        ].sort_values(\"Objetivo\")\n","\n","        ax.plot(\n","            holt[\"Objetivo\"], holt[\"Real\"],\n","            color=\"black\", marker=\"o\", markersize=3,\n","            label=\"Observado\"\n","        )\n","\n","        ax.plot(\n","            holt[\"Objetivo\"], holt[\"Pronostico\"],\n","            color=\"#1565C0\", label=\"Holt seleccionado\"\n","        )\n","\n","        ax.plot(\n","            baseline[\"Objetivo\"], baseline[\"Pronostico\"],\n","            color=\"#E65100\", linestyle=\"--\",\n","            label=\"Persistencia\"\n","        )\n","\n","        ax.set_title(f\"{etiquetas[instrumento]} — horizonte {h} meses\")\n","        ax.set_xlabel(\"Mes objetivo\")\n","        ax.set_ylabel(\"Tasa anualizada (%)\")\n","        ax.legend(fontsize=9)\n","        ax.tick_params(axis=\"x\", rotation=45)\n","\n","plt.show()\n","\n","print(\n","    \"Mejora positiva: Holt tiene menor RMSE que persistencia. \"\n","    \"Mejora negativa: persistencia tiene menor RMSE.\"\n",")\n","print(\n","    \"Son resultados de validación utilizados para seleccionar phi; \"\n","    \"la evaluación final permanece pendiente.\"\n",")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":1000},"id":"Prx6N5mnhKAr","executionInfo":{"status":"ok","timestamp":1791815365097,"user_tz":300,"elapsed":2554,"user":{"displayName":"PEDRO LUIS PEREZ BARAHONA","userId":"16526492446743362157"}},"outputId":"ae1d941a-dd1c-41bf-ac90-b84ad5144943"},"execution_count":null,"outputs":[{"output_type":"display_data","data":{"text/plain":["   Horizonte         Modelo  MAE_pb_Holt  MAE_pb_Baseline  RMSE_pb_Holt  \\\n","0          3  Holt phi=0.90        38.17            40.55         50.40   \n","1         12  Holt phi=0.90        99.66           112.10        130.72   \n","\n","   RMSE_pb_Baseline  Mejora_RMSE_%  \n","0             52.85           4.63  \n","1            138.49           5.61  "],"text/html":["\n","  <div id=\"df-2d1a41d5-42d2-4111-bcd3-4d4afdfee98d\" class=\"colab-df-container\">\n","    <div>\n","<style scoped>\n","    .dataframe tbody tr th:only-of-type {\n","        vertical-align: middle;\n","    }\n","\n","