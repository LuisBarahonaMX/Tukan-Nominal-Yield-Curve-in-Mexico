=\"MS\"\n",")\n","\n","origenes_prueba = pd.date_range(\n","    start=\"2020-10-01\",\n","    end=\"2025-09-01\",\n","    freq=\"MS\"\n",")\n","\n","def construir_calendario(origenes, etapa):\n","    registros = []\n","\n","    for origen in origenes:\n","        for h in HORIZONTES:\n","            objetivo = origen + pd.DateOffset(months=h)\n","\n","            if origen not in curva.index or objetivo not in curva.index:\n","                raise ValueError(\n","                    f\"Fecha fuera del archivo: {origen} → {objetivo}\"\n","                )\n","\n","            registros.append({\n","                \"Etapa\": etapa,\n","                \"Origen\": origen,\n","                \"Horizonte (meses)\": h,\n","                \"Mes objetivo\": objetivo,\n","                \"Tasas objetivo observadas\": int(\n","                    curva.loc[objetivo].notna().sum()\n","                )\n","            })\n","\n","    return pd.DataFrame(registros)\n","\n","calendario_evaluacion = pd.concat([\n","    construir_calendario(origenes_validacion, \"Validación\"),\n","    construir_calendario(origenes_prueba, \"Prueba\")\n","], ignore_index=True)\n","\n","# Todos los objetivos de validación deben preceder a la prueba\n","ultimo_objetivo_validacion = calendario_evaluacion.loc[\n","    calendario_evaluacion[\"Etapa\"].eq(\"Validación\"),\n","    \"Mes objetivo\"\n","].max()\n","\n","assert ultimo_objetivo_validacion < origenes_prueba.min()\n","\n","resumen_evaluacion = (\n","    calendario_evaluacion\n","    .groupby([\"Etapa\", \"Horizonte (meses)\"])\n","    .agg(\n","        Origenes=(\"Origen\", \"size\"),\n","        Primer_origen=(\"Origen\", \"min\"),\n","        Ultimo_origen=(\"Origen\", \"max\"),\n","        Primer_objetivo=(\"Mes objetivo\", \"min\"),\n","        Ultimo_objetivo=(\"Mes objetivo\", \"max\"),\n","        Objetivos_observados=(\"Tasas objetivo observadas\", \"sum\")\n","    )\n",")\n","\n","print(\"Variable objetivo:\")\n","print(\"Tasa anualizada promedio de subasta de cada instrumento en t+h.\")\n","\n","print(\"\\nInformación utilizada:\")\n","print(\"Únicamente información disponible hasta el mes de origen t.\")\n","\n","print(\"\\nSupuesto de disponibilidad:\")\n","print(\n","    \"Se supone que el promedio del mes t está disponible al cerrar ese mes. \"\n","    \"El CSV no permite verificar fechas de publicación ni revisiones.\"\n",")\n","\n","print(\"\\nEntrenamiento inicial:\")\n","print(\n","    f\"{curva.index.min():%Y-%m} a \"\n","    f\"{FIN_ENTRENAMIENTO_INICIAL:%Y-%m}\"\n",")\n","\n","print(\"\\nEsquema: ventana expansiva, avanzando un mes por origen.\")\n","display(resumen_evaluacion)\n","display(calendario_evaluacion.head(6))"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":653},"id":"gGAnwOJWaMY-","executionInfo":{"status":"ok","timestamp":1791825073261,"user_tz":300,"elapsed":228,"user":{"displayName":"PEDRO LUIS PEREZ BARAHONA","userId":"16526492446743362157"}},"outputId":"2a3e12ed-7eb5-4499-8676-0df8faaada9d"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Variable objetivo:\n","Tasa anualizada promedio de subasta de cada instrumento en t+h.\n","\n","Información utilizada:\n","Únicamente información disponible hasta el mes de origen t.\n","\n","Supuesto de disponibilidad:\n","Se supone que el promedio del mes t está disponible al cerrar ese mes. El CSV no permite verificar fechas de publicación ni revisiones.\n","\n","Entrenamiento inicial:\n","2006-10 a 2016-09\n","\n","Esquema: ventana expansiva, avanzando un mes por origen.\n"]},{"output_type":"display_data","data":{"text/plain":["                              Origenes Primer_origen Ultimo_origen  \\\n","Etapa      Horizonte (meses)                                         \n","Prueba     3                        60    2020-10-01    2025-09-01   \n","           12                       60    2020-10-01    2025-09-01   \n","Validación 3                        36    2016-10-