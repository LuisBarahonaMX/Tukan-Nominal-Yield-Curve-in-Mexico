fica causas económicas.\n"]}]},{"cell_type":"code","source":["# CELDA 27 — Estructura común entre décadas\n","\n","periodos_estructura = [\n","    (\"Primera década\", \"2006-10-01\", \"2016-09-01\"),\n","    (\"Segunda década\", \"2016-10-01\", \"2026-09-01\")\n","]\n","\n","resultados_estructura = []\n","cargas_estructura = {}\n","\n","for nombre, inicio, fin in periodos_estructura:\n","\n","    # Preparar hasta el cierre de cada periodo, usando solo el pasado\n","    preparada, _ = preparar_historia(curva, pd.Timestamp(fin))\n","\n","    niveles = preparada.loc[inicio:fin]\n","\n","    # Calcular diferencias antes de seleccionar el periodo:\n","    # el primer cambio de la segunda década usa el mes anterior.\n","    cambios = preparada.diff().loc[inicio:fin].dropna()\n","\n","    # Comprobación sin imputación, con los nueve plazos observados\n","    completos = curva.loc[inicio:fin].dropna()\n","\n","    muestras = {\n","        \"Niveles preparados\": niveles,\n","        \"Cambios preparados\": cambios,\n","        \"Niveles completos observados\": completos\n","    }\n","\n","    for tipo, tabla in muestras.items():\n","        if len(tabla) < 10:\n","            print(f\"Muestra insuficiente: {nombre}, {tipo}\")\n","            continue\n","\n","        pca = PCA(svd_solver=\"full\").fit(tabla)\n","\n","        acumulada = np.cumsum(\n","            pca.explained_variance_ratio_\n","        ) * 100\n","\n","        resultados_estructura.append({\n","            \"Periodo\": nombre,\n","            \"Datos\": tipo,\n","            \"Meses\": len(tabla),\n","            \"PC1_%\": acumulada[0],\n","            \"PC1_PC2_%\": acumulada[1],\n","            \"PC1_PC3_%\": acumulada[2]\n","        })\n","\n","        if tipo == \"Niveles preparados\":\n","            cargas = pca.components_[:3].T.copy()\n","\n","            # Orientar signos solo para facilitar la lectura\n","            for j in range(3):\n","                if cargas[np.argmax(np.abs(cargas[:, j])), j] < 0:\n","                    cargas[:, j] *= -1\n","\n","            cargas_estructura[nombre] = pd.DataFrame(\n","                cargas,\n","                index=tabla.columns,\n","                columns=[\"PC1\", \"PC2\", \"PC3\"]\n","            )\n","\n","resumen_estructura = pd.DataFrame(resultados_estructura)\n","\n","print(\"VARIANZA ACUMULADA EXPLICADA (%)\")\n","print(resumen_estructura.round(2).to_string(index=False))\n","\n","for periodo, tabla in cargas_estructura.items():\n","    print(f\"\\nCARGAS — {periodo.upper()}\")\n","    print(\n","        tabla.rename(index=etiquetas)\n","        .round(3)\n","        .to_string()\n","    )\n","\n","fig, axes = plt.subplots(\n","    1, 2,\n","    figsize=(15, 5),\n","    constrained_layout=True\n",")\n","\n","for ax, (periodo, tabla) in zip(axes, cargas_estructura.items()):\n","    for componente in tabla.columns:\n","        ax.plot(\n","            nombres_cortos,\n","            tabla[componente],\n","            marker=\"o\",\n","            label=componente\n","        )\n","\n","    ax.axhline(0, color=\"gray\", linewidth=1)\n","    ax.set_title(periodo, fontweight=\"bold\")\n","    ax.set_xlabel(\"Vencimiento — eje categórico\")\n","    ax.set_ylabel(\"Carga del componente\")\n","    ax.legend()\n","\n","plt.show()\n","\n","print(\n","    \"\\nLos meses completos son una muestra pequeña y seleccionada \"\n","    \"por disponibilidad: sirven como contraste, no eliminan todo sesgo.\"\n",")\n","print(\n","    \"Los cambios preparados siguen afectados por el arrastre de tasas. \"\n","    \"Porcentajes similares no garantizan cargas idénticas.\"\n",")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":1000},"id":"ZNlnpg6X5AZh","executionInfo":{"status":"ok","timestamp":1791821616289,"user_tz":300,"elapsed":1030,"user":{"displayName":"PEDRO LUIS PEREZ BARAHONA","userId":"16526492446743362157"}},"outputId":"f19edea6-8189-4206-8c2d-dae92c48f7f0"},"execution_count":null,"outputs":[{"o