100\",\n","        label=\"Acumulada\"\n","    )\n","\n","    ax.set_title(f\"PCA de {nombre.lower()}: varianza explicada\")\n","    ax.set_xlabel(\"Componente principal\")\n","    ax.set_ylabel(\"Porcentaje\")\n","    ax.set_xticks(componentes)\n","    ax.set_ylim(0, 105)\n","    ax.legend()\n","\n","    # Cargas de los primeros tres componentes\n","    ax = axes[fila, 1]\n","\n","    for componente in range(3):\n","        cargas = pca.components_[componente].copy()\n","\n","        # Orientar el signo solo para facilitar la lectura del gráfico\n","        if cargas[np.argmax(np.abs(cargas))] < 0:\n","            cargas *= -1\n","\n","        ax.plot(\n","            nombres_cortos,\n","            cargas,\n","            marker=\"o\",\n","            label=f\"PC{componente + 1}\"\n","        )\n","\n","    ax.axhline(0, color=\"gray\", linewidth=1)\n","    ax.set_title(f\"PCA de {nombre.lower()}: cargas\")\n","    ax.set_xlabel(\"Vencimiento — eje categórico\")\n","    ax.set_ylabel(\"Carga del componente\")\n","    ax.legend()\n","\n","plt.show()\n","\n","print(\n","    \"Análisis exploratorio: el PCA utiliza entradas con arrastre de \"\n","    \"última observación. Los cambios incluyen ceros inducidos por \"\n","    \"ese tratamiento; contrastaremos su influencia.\"\n",")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":1000},"id":"4phQCG9mcRDx","executionInfo":{"status":"ok","timestamp":1791814095847,"user_tz":300,"elapsed":4460,"user":{"displayName":"PEDRO LUIS PEREZ BARAHONA","userId":"16526492446743362157"}},"outputId":"9741f7a8-e63d-4172-8b09-6b93325ceb9c"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["\n","PCA de niveles — 119 meses\n"]},{"output_type":"display_data","data":{"text/plain":["  Componente  Varianza explicada (%)  Varianza acumulada (%)\n","0        PC1                   90.55                   90.55\n","1        PC2                    7.23                   97.78\n","2        PC3      