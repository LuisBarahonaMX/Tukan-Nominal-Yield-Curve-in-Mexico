mbre == \"Niveles\":\n","        fechas_recientes = antiguedad_inicial.le(3).all(axis=1)\n","\n","    else:\n","        # Para un cambio, revisar ambos extremos del intervalo\n","        fechas_recientes = (\n","            antiguedad_inicial.le(3).all(axis=1)\n","            & antiguedad_inicial.shift(1).le(3).all(axis=1)\n","        )\n","\n","    subconjuntos = {\n","        \"Todas las entradas preparadas\": tabla,\n","        \"Antigüedad máxima de 3 meses\": tabla.loc[\n","            fechas_recientes.reindex(tabla.index).fillna(False)\n","        ]\n","    }\n","\n","    for muestra, subtabla in subconjuntos.items():\n","\n","        # Mínimo operativo para esta comparación exploratoria\n","        if len(subtabla) < 10:\n","            print(f\"Sin muestra suficiente: {nombre}, {muestra}\")\n","            continue\n","\n","        for estandarizar in [False, True]:\n","\n","            valores = subtabla.to_numpy()\n","\n","            if estandarizar:\n","                valores = StandardScaler().fit_transform(valores)\n","\n","            pca = PCA(svd_solver=\"full\").fit(valores)\n","\n","            acumulada = np.cumsum(\n","                pca.explained_variance_ratio_\n","            ) * 100\n","\n","            resultados_sensibilidad.append({\n","                \"Datos\": nombre,\n","                \"Muestra\": muestra,\n","                \"Escalado\": (\n","                    \"Estandarizado\"\n","                    if estandarizar else \"Solo centrado\"\n","                ),\n","                \"Meses\": len(subtabla),\n","                \"PC1 (%)\": acumulada[0],\n","                \"PC1–PC2 (%)\": acumulada[1],\n","                \"PC1–PC3 (%)\": acumulada[2]\n","            })\n","\n","resumen_sensibilidad = pd.DataFrame(resultados_sensibilidad)\n","display(resumen_sensibilidad.round(2))\n","\n","print(\n","    \"Las variantes pueden usar meses distintos. \"\n","    \"Filtrar por antigüedad no elimina toda la imputación.\"\n",")\n"