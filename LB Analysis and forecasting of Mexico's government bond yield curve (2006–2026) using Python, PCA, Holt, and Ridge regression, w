"add\",\n","                    damped_trend=True,\n","                    seasonal=None,\n","                    initialization_method=\"estimated\"\n","                ).fit(\n","                    damping_trend=phi,\n","                    optimized=True,\n","                    use_brute=True\n","                )\n","\n","            resultado_opt = getattr(ajuste, \"mle_retvals\", None)\n","            convergio = (\n","                bool(resultado_opt.get(\"success\", True))\n","                if resultado_opt is not None else True\n","            )\n","\n","            pronosticos = np.asarray(\n","                ajuste.forecast(max(HORIZONTES)),\n","                dtype=float\n","            )\n","\n","            diagnosticos.append({\n","                \"Phi\": phi,\n","                \"Origen\": origen,\n","                \"Instrumento\": instrumento,\n","                \"Convergio\": convergio,\n","                \"Avisos\": \" | \".join(str(a.message) for a in avisos)\n","            })\n","\n","            if not convergio or not np.isfinite(pronosticos).all():\n","                raise RuntimeError(\n","                    f\"Revisar ajuste Holt: {instrumento}, \"\n","                    f\"origen={origen:%Y-%m}, phi={phi}. \"\n","                    f\"Resultado del optimizador: {resultado_opt}\"\n","                )\n","\n","            for h in HORIZONTES:\n","                objetivo = origen + pd.DateOffset(months=h)\n","\n","                registros.append({\n","                    \"Modelo\": f\"Holt phi={phi:.2f}\",\n","                    \"Etapa\": \"Validación\",\n","                    \"Origen\": origen,\n","                    \"Horizonte\": h,\n","                    \"Objetivo\": objetivo,\n","                    \"Instrumento\": instrumento,\n","                    \"Real\": curva_original.loc[objetivo, instrumento],\n","                    \"Pronostico\": pronosticos[h - 1],\n","                    \"Phi\": phi\n","                })\n","\n","        if numero % 12 == 0 or numero == len(origenes):\n","            print(\n","                f\"phi={phi:.2f}: \"\n","                f\"{numero}/{len(origenes)} orígenes completados\"\n","            )\n","\n","    return pd.DataFrame(registros), pd.DataFrame(diagnosticos)\n","\n","print(\"Modelo definido: tendencia aditiva amortiguada, sin estacionalidad.\")\n","print(\"Configuraciones phi:\", PHIS_HOLT)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"QbQLnsIsgL3i","executionInfo":{"status":"ok","timestamp":1791815108015,"user_tz":300,"elapsed":41,"user":{"displayName":"PEDRO LUIS PEREZ BARAHONA","userId":"16526492446743362157"}},"outputId":"ac0eb4a7-f446-41f1-b18e-84c334a0de1d"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Modelo definido: tendencia aditiva amortiguada, sin estacionalidad.\n","Configuraciones phi: [0.8, 0.9, 0.98]\n"]}]},{"cell_type":"markdown","source":["Celda 14. Ejecutar la validación y seleccionar phi\n","Esta celda realizará 972 ajustes: tres configuraciones × 36 orígenes × nueve instrumentos. Puede tardar unos minutos."],"metadata":{"id":"QCOFDE6-gTDq"}},{"cell_type":"code","source":["# CELDA 14 — Validación temporal de Holt\n","\n","predicciones_holt_lista = []\n","diagnosticos_holt_lista = []\n","\n","for phi in PHIS_HOLT:\n","    predicciones, diagnosticos = validar_holt(\n","        curva,\n","        origenes_validacion,\n","        phi\n","    )\n","\n","    predicciones_holt_lista.append(predicciones)\n","    diagnosticos_holt_lista.append(diagnosticos)\n","\n","predicciones_holt_validacion = pd.concat(\n","    predicciones_holt_lista,\n","    ignore_index=True\n",")\n","\n","diagnosticos_holt = pd.concat(\n","    diagnosticos_holt_lista,\n","    ignore_index=True\n",")\n","\n","# Verificar los mismos orígenes, objetivos y tasas reales del baseline\n","claves = [\"Etapa\", \"Origen\", \"Horizonte\", \"Objetivo\", \"Instrumento\"]\n","\n","referencia = predicciones_baseline_validacion.set_index(\n","    claves\n",")[\"Real\"].sort_index()\n","\n","for nombre, grupo in predicciones_holt_validacion.groupby(\"Modelo\"):\n","    comparacion = grupo.set_index(claves)[\"Real\"].sort_index()\n","\n","    assert comparacion.index.equals(referencia.index), nombre\n","    assert np.allclose(\n","        comparacion.to_numpy(),\n","        referencia.to_numpy(),\n","        equal_nan=True\n","    ), nombre\n","\n","metricas_holt_plazo, metricas_holt_global = calcular_metricas(\n","    predicciones_holt_validacion\n",")\n","\n","print(\"Resultados de las configuraciones en validación\")\n","display(\n","    metricas_holt_global\n","    .sort_values([\"Horizonte\", \"RMSE_pb\"])\n","    .round(2)\n",")\n","\n","# Seleccionar por RMSE global, con igual peso para cada plazo\n","mejores_holt = (\n","    metricas_holt_global\n","    .sort_values([\"Horizonte\", \"RMSE_pb\", \"Modelo\"])\n","    .drop_duplicates(\"Horizonte\")\n","    .copy()\n",")\n","\n","nombre_a_phi = {\n","    f\"Holt phi={phi:.2f}\": phi\n","    for phi in PHIS_HOLT\n","}\n","\n","config_holt_por_horizonte = {\n","    int(fila[\"Horizonte\"]): nombre_a_phi[fila[\"Modelo\"]]\n","    for _, fila in mejores_holt.iterrows()\n","}\n","\n","print(\"Configuraciones seleccionadas mediante validación:\")\n","print(config_holt_por_horizonte)\n","\n","print(\"\\nDiagnósticos:\")\n","print(f\"Ajustes realizados: {len(diagnosticos_holt)}\")\n","print(f\"Ajustes convergentes: {diagnosticos_holt['Convergio'].sum()}\")\n","\n","con_avisos = diagnosticos_holt.loc[\n","    diagnosticos_holt[\"Avisos\"].ne(\"\")\n","]\n","\n","print(f\"Ajustes con avisos: {len(con_avisos)}\")\n","\n","if not con_avisos.empty:\n","    display(con_avisos.head(10))"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":753},"id":"ztXfTy7GgVNy","executionInfo":{"status":"ok","timestamp":1791815194638,"user_tz":300,"elapsed":48607,"user":{"displayName":"PEDRO LUIS PEREZ BARAHONA","