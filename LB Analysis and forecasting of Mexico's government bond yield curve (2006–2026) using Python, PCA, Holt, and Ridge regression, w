}\n  ]\n}"}},"metadata":{}},{"output_type":"stream","name":"stdout","text":["Las variantes pueden usar meses distintos. Filtrar por antigüedad no elimina toda la imputación.\n","En datos estandarizados, la varianza se mide en otra escala; los porcentajes no representan exactamente la misma magnitud.\n"]}]},{"cell_type":"markdown","source":["### Celda 12. Crear el baseline y medirlo en validación\n","El baseline conserva la última tasa observada de cada plazo. Guardaremos todas las predicciones, incluso cuando falte la tasa objetivo, para mantener una estructura común de evaluación.\n"],"metadata":{"id":"dRbpPUcCfFbt"}},{"cell_type":"code","source":["# CELDA 12 — Persistencia y métricas de validación\n","\n","def pronosticar_persistencia(curva_original, origenes, etapa):\n","    registros = []\n","\n","    for origen in origenes:\n","        historia = curva_original.loc[:origen]\n","        ultima_tasa = historia.ffill().iloc[-1]\n","\n","        if ultima_tasa.isna().any():\n","            raise ValueError(\n","                f\"Falta historia para algún instrumento en {origen}.\"\n","            )\n","\n","        for h in HORIZONTES:\n","            objetivo = origen + pd.DateOffset(months=h)\n","            observado = curva_original.loc[objetivo]\n","\n","            for instrumento in curva_original.columns:\n","                registros.append({\n","                    \"Modelo\": \"Persistencia\",\n","                    \"Etapa\": etapa,\n","                    \"Origen\": origen,\n","                    \"Horizonte\": h,\n","                    \"Objetivo\": objetivo,\n","                    \"Instrumento\": instrumento,\n","                    \"Real\": observado[instrumento],\n","                    \"Pronostico\": ultima_tasa[instrumento]\n","                })\n","\n","    return pd.DataFrame(registros)\n","\n","\n","def calcular_metricas(predicciones):\n","    # Solo evaluar objetivos observados\n","    evaluables = predicciones.loc[\n","        predicciones[\"Real\"].notna()\n","    ].copy()\n","\n","    if not np.isfinite(evaluables[\"Pronostico\"]).all():\n","        raise ValueError(\"Hay pronósticos inválidos en objetivos evaluables.\")\n","\n","    evaluables[\"Error_pb\"] = (\n","        evaluables[\"Pronostico\"] - evaluables[\"Real\"]\n","    ) * 100\n","\n","    evaluables[\"Error_absoluto_pb\"] = evaluables[\"Error_pb\"].abs()\n","    evaluables[\"Error_cuadrado_pb\"] = evaluables[\"Error_pb\"].pow(2)\n","\n","    por_plazo = (\n","        evaluables\n","        .groupby([\"Modelo\", \"Etapa\", \"Horizonte\", \"Instrumento\"])\n","        .agg(\n","            N=(\"Error_pb\", \"size\"),\n","            MAE_pb=(\"Error_absoluto_pb\", \"mean\"),\n","            MSE_pb2=(\"Error_cuadrado_pb\", \"mean\")\n","        )\n","        .reset_index()\n","    )\n","\n","    por_plazo[\"RMSE_pb\"] = np.sqrt(por_plazo[\"MSE_pb2\"])\n","\n","    # Igual peso para cada instrumento\n","    globales = (\n","        por_plazo\n","        .groupby([\"Modelo\", \"Etapa\", \"Horizonte\"])\n","        .agg(\n","            Plazos_evaluados=(\"Instrumento\", \"nunique\"),\n","            Observaciones=(\"N\", \"sum\"),\n","            MAE_pb=(\"MAE_pb\", \"mean\"),\n","            MSE_pb2=(\"MSE_pb2\", \"mean\")\n","        )\n","        .reset_index()\n","    )\n","\n","    globales[\"RMSE_pb\"] = np.sqrt(globales[\"MSE_pb2\"])\n","\n","    return (\n","        por_plazo.drop(columns=\"MSE_pb2\"),\n","        globales.drop(columns=\"MSE_pb2\")\n","    )\n","\n","\n","predicciones_baseline_validacion = pronosticar_persistencia(\n","    curva,\n","    origenes_validacion,\n","    etapa=\"Validación\"\n",")\n","\n","metricas_baseline_plazo, metricas_baseline_global = calcular_metricas(\n","    predicciones_baseline_validacion\n",")\n","\n","print(\"Baseline: resultados globales de validación\")\n","display(metricas_baseline_global.round(2))\n","\n","print(\"Baseline: resultados por instrumento\")\n","display(\n","    metricas_baseline_plazo\n","    .replace({\"Instrumento\": etiquetas})\n","    .round(2)\n",")\n","\n","print(\"Primeras predicciones\")\n","display(predicciones_baseline_validacion.head())\n","\n","print(\n","    \"Los objetivos faltantes se conservan en la tabla, \"\n","    \"pero no participan en las métricas.\"\n",")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":968},"id":"uuA0ABJSfHz7","executionInfo":{"status":"ok","timestamp":1791814829556,"user_tz":300,"elapsed":316,"user":{"displayName":"PEDRO LUIS PEREZ BARAHONA","userId":"16526492446743362157"}},"outputId":"ca5e239e-e278-4ebd-9ab3-95b237616b3c"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Baseline: resultados globales de validación\n"]},{"output_type":"display_data","data":{"text/plain":["         Modelo       Etapa  Horizonte  Plazos_evaluados  Observaciones  \\\n","0  Persistencia  Validación          3                 9            294   \n","1  Persistencia  Validación         12                 9            294   \n","\n","   MAE_pb  RMSE_pb  \n","0   40.55    52.85  \n","1  112.10   138.49  "],"text/html":["\n","  <div id=\"df-36917a47-f61e-4e88-aea2-5e36a9716f0e\" class=\"colab-df-container\">\n","    <div>\n","<style scoped>\n","    .dataframe tbody tr th:only-of-type {\n","        vertical-align: middle;\n","    }\n","\n","    .dataframe tbody tr th {\n","        vertical-align: top;\n","    }\n","\n","    .dataframe thead th {\n","        text-align: right;\n","    }\n","</style>\n","<table border=\"1\" class=\"dataframe\">\n","  <thead>\n","    <tr style=\"text-align: right;\">\n","      <th></th>\n","      <th>Modelo</th>\n","      <th>Etapa</th>\n","      <th>Horizonte</th>\n","      <th>Plazos_evaluados</th>\n","      <th>Observaciones</th>\n","      <th>MAE_pb</th>\n","      <th>RMSE_pb</th>\n","    </tr>\n","  </thead>\n","  <tbody>\n","    <tr>\n","      <th>0</th>\n","      <td>Persistencia</td>\n","      <td>Validación</td>\n","    