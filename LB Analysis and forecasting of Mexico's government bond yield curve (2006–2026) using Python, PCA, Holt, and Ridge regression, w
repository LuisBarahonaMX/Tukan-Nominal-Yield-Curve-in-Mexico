S_FINALES[\"Holt\"][h]\n","\n","        for instrumento in curva.columns:\n","            predicciones = {\n","                \"Persistencia\": preparada.iloc[-1][instrumento],\n","                \"Holt\": pronosticos_holt[(instrumento, phi)][h - 1],\n","                \"Ridge\": pred_ridge[instrumento],\n","                \"PCA + Ridge\": pred_pca[instrumento]\n","            }\n","\n","            for nombre, prediccion in predicciones.items():\n","                registros_prueba.append({\n","                    \"Modelo\": nombre,\n","                    \"Etapa\": \"Prueba\",\n","                    \"Origen\": origen,\n","                    \"Horizonte\": h,\n","                    \"Objetivo\": objetivo,\n","                    \"Instrumento\": instrumento,\n","                    \"Real\": curva.loc[objetivo, instrumento],\n","                    \"Pronostico\": float(prediccion)\n","                })\n","\n","    if numero % 12 == 0:\n","        print(f\"Prueba: {numero}/{len(origenes_prueba)} orígenes\")\n","\n","\n","predicciones_prueba = pd.DataFrame(registros_prueba)\n","diagnosticos_holt_prueba = pd.DataFrame(\n","    diagnosticos_holt_prueba_lista\n",")\n","\n","# Verificar comparación sobre los mismos objetivos\n","claves = [\"Etapa\", \"Origen\", \"Horizonte\", \"Objetivo\", \"Instrumento\"]\n","\n","referencia_prueba = (\n","    predicciones_prueba.loc[\n","        predicciones_prueba[\"Modelo\"].eq(\"Persistencia\")\n","    ]\n","    .set_index(claves)[\"Real\"]\n","    .sort_index()\n",")\n","\n","for nombre, grupo in predicciones_prueba.groupby(\"Modelo\"):\n","    assert not grupo.duplicated(claves).any()\n","\n","    reales = grupo.set_index(claves)[\"Real\"].sort_index()\n","\n","    assert reales.index.equals(referencia_prueba.index), nombre\n","    assert np.allclose(\n","        reales.to_numpy(),\n","        referencia_prueba.to_numpy(),\n","        equal_nan=True\n","    ), nombre\n","\n","metricas_prueba_plazo, metricas_prueba_glo