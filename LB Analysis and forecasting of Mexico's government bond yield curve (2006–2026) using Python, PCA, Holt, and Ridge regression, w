es_prueba)\n","\n","    for longitud_bloque in [h, 2 * h]:\n","        rng = np.random.default_rng(\n","            SEMILLA_BOOTSTRAP + h + longitud_bloque\n","        )\n","\n","        numero_bloques = int(np.ceil(n / longitud_bloque))\n","\n","        # Bootstrap circular: los bloques pueden envolver el final\n","        inicios = rng.integers(\n","            0, n,\n","            size=(N_BOOTSTRAP, numero_bloques)\n","        )\n","\n","        indices = (\n","            (\n","                inicios[..., None]\n","                + np.arange(longitud_bloque)\n","            ) % n\n","        ).reshape(N_BOOTSTRAP, -1)[:, :n]\n","\n","        for modelo, referencia in comparaciones_bootstrap:\n","            errores_a = errores_modelos[modelo]\n","            errores_b = errores_modelos[referencia]\n","\n","            # Las mismas fechas se remuestrean en ambos modelos\n","            muestra_a = errores_a[indices]\n","            muestra_b = errores_b[indices]\n","\n","            # Cada réplica debe conservar datos de todos los plazos\n","            replicas_validas = (\n","                np.isfinite(muestra_a).any(axis=1).all(axis=1)\n","                & np.isfinite(muestra_b).any(axis=1).all(axis=1)\n","            )\n","\n","            if replicas_validas.sum() < 0.95 * N_BOOTSTRAP:\n","                raise ValueError(\n","                    \"Demasiadas réplicas sin cobertura de los nueve plazos.\"\n","                )\n","\n","            diferencias = (\n","                rmse_global_desde_errores(muestra_a[replicas_validas])\n","                - rmse_global_desde_errores(muestra_b[replicas_validas])\n","            )\n","\n","            diferencia_observada = (\n","                rmse_global_desde_errores(errores_a)\n","                - rmse_global_desde_errores(errores_b)\n","            )\n","\n","            inferior, superior = np.quantile(\n","                diferencias, [0.025, 0.975]\n","            )\n","\n","            if superior < 0:\n","                lectura = \"Intervalo a favor del modelo\"\n","            elif inferior > 0:\n","                lectura = \"Intervalo a favor de la referencia\"\n","            else:\n","                lectura = \"Incluye cero\"\n","\n","            resultados_bootstrap.append({\n","                \"Horizonte\": h,\n","                \"Bloque_meses\": longitud_bloque,\n","                \"Modelo\": modelo,\n","                \"Referencia\": referencia,\n","                \"Diferencia_RMSE_pb\": diferencia_observada,\n","                \"IC95_inferior\": inferior,\n","                \"IC95_superior\": superior,\n","                \"Replicas_validas\": int(replicas_validas.sum()),\n","                \"Lectura\": lectura\n","            })\n","\n","intervalos_comparacion = pd.DataFrame(resultados_bootstrap)\n","\n","print(\"DIFERENCIA = RMSE DEL MODELO − RMSE DE LA REFERENCIA\")\n","print(\"Valores negativos favorecen al modelo.\\n\")\n","\n","print(\n","    intervalos_comparacion\n","    .round(2)\n","    .to_string(index=False)\n",")\n","\n","print(\n","    \"\\nIntervalos exploratorios del desempeño comparado; \"\n","    \"no son intervalos de predicción de tasas futuras.\"\n",")\n","print(\n","    \"Se remuestrean errores de modelos ya seleccionados, sin reentrenarlos. \"\n","    \"No se ajusta por comparaciones múltiples.\"\n",")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"8fr1iKMn3dXf","executionInfo":{"status":"ok","timestamp":1791821257243,"user_tz":300,"elapsed":1520,"user":{"displayName":"PEDRO LUIS PEREZ BARAHONA","userId":"16526492446743362157"}},"outputId":"bb6fd926-972d-4e1c-ffba-802dc70a7bfd"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["DIFERENCIA = RMSE DEL MODELO − RMSE DE LA REFERENCIA\n","Valores negativos favorecen al modelo.\n","\n"," Horizonte  Bloque_meses      Modelo   Referencia  Diferencia_RMSE_pb  IC95_inferior  IC95_superior  Replicas_validas              